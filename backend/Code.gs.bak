const CRM_CONFIG = {
  pricingSheet: 'Product Pricing',
  enquiriesSheet: 'Enquiries',
  itemsSheet: 'Enquiry Items',
  dashboardSheet: 'Dashboard',
  businessName: 'Concrete Ideas'
};

